#!/usr/bin/env sh
# light-harness: the harness command line. Finds a Python 3.9+ interpreter (python3, python or
# py -3, so it works on macOS, Linux and Windows/Git Bash) and runs the plugin's harness.py.
# The plugin's SessionStart hook puts this folder on the Bash tool's PATH.
# `pwd -W` gives a native path on Windows (Git Bash), so Windows Python can open the script even
# when MSYS path conversion is off (MSYS_NO_PATHCONV=1); elsewhere it fails and `pwd` is used.
DIR=$(cd "$(dirname "$0")" && { pwd -W 2>/dev/null || pwd; })
for PY in python3 python "py -3"; do
  # shellcheck disable=SC2086  # "py -3" must word-split
  if $PY -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' >/dev/null 2>&1; then
    exec $PY "$DIR/../scripts/harness.py" "$@"
  fi
done
echo "light-harness: Python 3.9+ not found (tried python3, python, py -3). Install it and put it on PATH." >&2
exit 127
